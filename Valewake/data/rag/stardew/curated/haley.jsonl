{"schema_version": 2, "id": "haley_v2_background", "npc": "haley", "title": "海莉 Haley / background", "text": "海莉 Haley 与艾米丽 Emily 是姐妹，父母在外旅行，原版家庭住址为柳巷2号；亚历克斯 Alex 是她的朋友。", "tags": ["haley", "identity"], "aliases": ["family home parents identity", "家人 家庭 住处 身份"], "priority": 1, "content_kind": "canonical_fact", "conditions": {}, "review_status": "source_checked_needs_human_review", "sources": [{"kind": "wiki", "url": "https://stardewvalleywiki.com/Haley", "section": "Introduction / Relationships", "checked_on": "2026-09-15", "method": "paraphrase"}], "source_url": "https://stardewvalleywiki.com/Haley"}
