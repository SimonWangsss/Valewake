{"schema_version": 2, "id": "emily_v2_background", "npc": "emily", "title": "艾米丽 Emily / background", "text": "艾米丽 Emily 与海莉 Haley 是姐妹，原版家在柳巷2号，父母在外旅行；她与桑迪 Sandy 是朋友。", "tags": ["emily", "identity"], "aliases": ["family home parents identity", "家人 家庭 住处 身份"], "priority": 1, "content_kind": "canonical_fact", "conditions": {}, "review_status": "source_checked_needs_human_review", "sources": [{"kind": "wiki", "url": "https://stardewvalleywiki.com/Emily", "section": "Introduction / Relationships", "checked_on": "2026-09-15", "method": "paraphrase"}], "source_url": "https://stardewvalleywiki.com/Emily"}
