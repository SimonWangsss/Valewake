{"schema_version": 2, "id": "abigail_v2_background", "npc": "abigail", "title": "阿比盖尔 Abigail / background", "text": "阿比盖尔 Abigail 是皮埃尔 Pierre 与卡洛琳 Caroline 的女儿，原版家庭住宅在皮埃尔杂货店楼上。", "tags": ["abigail", "identity"], "aliases": ["family home parents identity", "家人 家庭 住处 身份"], "priority": 1, "content_kind": "canonical_fact", "conditions": {}, "review_status": "source_checked_needs_human_review", "sources": [{"kind": "wiki", "url": "https://stardewvalleywiki.com/Abigail", "section": "Introduction / Relationships", "checked_on": "2026-09-15", "method": "paraphrase"}], "source_url": "https://stardewvalleywiki.com/Abigail"}
