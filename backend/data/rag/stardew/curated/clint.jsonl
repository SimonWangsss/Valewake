{"schema_version": 2, "id": "clint_v2_background", "npc": "clint", "title": "克林特 Clint / background", "text": "克林特 Clint 是鹈鹕镇铁匠，店铺提供工具升级、矿物相关商品和晶球处理。", "tags": ["clint", "identity"], "aliases": ["family home parents identity", "家人 家庭 住处 身份"], "priority": 1, "content_kind": "canonical_fact", "conditions": {}, "review_status": "source_checked_needs_human_review", "sources": [{"kind": "wiki", "url": "https://stardewvalleywiki.com/Clint", "section": "Introduction / Relationships", "checked_on": "2026-09-15", "method": "paraphrase"}], "source_url": "https://stardewvalleywiki.com/Clint"}
