{"schema_version": 2, "id": "world_v2_geography", "npc": "", "title": "山谷公共知识  / geography", "text": "鹈鹕镇南面是海滩，北面通向山地，西南方是煤矿森林，西北方连接巴士站和农场。", "tags": ["places"], "aliases": [], "priority": 1, "content_kind": "canonical_fact", "conditions": {}, "review_status": "source_checked_needs_human_review", "sources": [{"kind": "wiki", "url": "https://stardewvalleywiki.com/Pelican_Town", "section": "Introduction", "checked_on": "2026-09-15", "method": "paraphrase"}], "source_url": "https://stardewvalleywiki.com/Pelican_Town"}
{"schema_version": 2, "id": "world_v2_services", "npc": "", "title": "山谷公共知识  / services", "text": "鹈鹕镇的日常设施包括皮埃尔杂货店、哈维诊所、克林特铁匠铺、格斯的星之果实餐吧，以及冈瑟负责的博物馆和图书馆。", "tags": ["places"], "aliases": [], "priority": 1, "content_kind": "canonical_fact", "conditions": {}, "review_status": "source_checked_needs_human_review", "sources": [{"kind": "wiki", "url": "https://stardewvalleywiki.com/Pelican_Town", "section": "Key Locations", "checked_on": "2026-09-15", "method": "paraphrase"}], "source_url": "https://stardewvalleywiki.com/Pelican_Town"}
{"schema_version": 2, "id": "world_v2_calendar", "npc": "", "title": "山谷公共知识  / calendar", "text": "山谷一年依次经历春、夏、秋、冬，每季28天；季节会影响作物、采集物和鱼类。", "tags": ["seasons"], "aliases": [], "priority": 1, "content_kind": "canonical_fact", "conditions": {}, "review_status": "source_checked_needs_human_review", "sources": [{"kind": "wiki", "url": "https://stardewvalleywiki.com/Seasons", "section": "Introduction", "checked_on": "2026-09-15", "method": "paraphrase"}], "source_url": "https://stardewvalleywiki.com/Seasons"}
{"schema_version": 2, "id": "world_v2_rain", "npc": "", "title": "山谷公共知识  / rain", "text": "普通雨天会为室外作物浇水，温室内不受室外降雨直接影响。", "tags": ["weather"], "aliases": [], "priority": 1, "content_kind": "canonical_fact", "conditions": {}, "review_status": "source_checked_needs_human_review", "sources": [{"kind": "wiki", "url": "https://stardewvalleywiki.com/Weather", "section": "Rain", "checked_on": "2026-09-15", "method": "paraphrase"}], "source_url": "https://stardewvalleywiki.com/Weather"}
{"schema_version": 2, "id": "world_v2_mines", "npc": "", "title": "山谷公共知识  / mines", "text": "镇北的矿井中有石头、矿石、宝石、通往下层的梯子与怪物，深处的矿物和危险会变化。", "tags": ["mines"], "aliases": [], "priority": 1, "content_kind": "canonical_fact", "conditions": {}, "review_status": "source_checked_needs_human_review", "sources": [{"kind": "wiki", "url": "https://stardewvalleywiki.com/The_Mines", "section": "Overview / Floors", "checked_on": "2026-09-15", "method": "paraphrase"}], "source_url": "https://stardewvalleywiki.com/The_Mines"}
{"schema_version": 2, "id": "world_v2_spring_festivals", "npc": "", "title": "山谷公共知识  / spring_festivals", "text": "春季13日是镇上的复活节寻蛋活动，春季24日是煤矿森林的花舞节。", "tags": ["festivals"], "aliases": [], "priority": 1, "content_kind": "canonical_fact", "conditions": {}, "review_status": "source_checked_needs_human_review", "sources": [{"kind": "wiki", "url": "https://stardewvalleywiki.com/Festivals", "section": "Egg Festival / Flower Dance", "checked_on": "2026-09-15", "method": "paraphrase"}], "source_url": "https://stardewvalleywiki.com/Festivals"}
{"schema_version": 2, "id": "world_v2_summer_festivals", "npc": "", "title": "山谷公共知识  / summer_festivals", "text": "夏季11日的夏威夷宴会在海滩举行，居民带来食材合煮百乐汤供州长品尝；夏季28日晚会在海边观看月光水母。", "tags": ["festivals"], "aliases": [], "priority": 1, "content_kind": "canonical_fact", "conditions": {}, "review_status": "source_checked_needs_human_review", "sources": [{"kind": "wiki", "url": "https://stardewvalleywiki.com/Festivals", "section": "Luau / Dance of the Moonlight Jellies", "checked_on": "2026-09-15", "method": "paraphrase"}], "source_url": "https://stardewvalleywiki.com/Festivals"}
